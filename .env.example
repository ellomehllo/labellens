# Required for label reading and analysis. Server-side only, never sent to the browser.
ANTHROPIC_API_KEY=

# Optional
# LABELLENS_MODEL=claude-opus-5-5
# PORT=8787
# Max AI calls per day across all users (cost control)
# LABELLENS_DAILY_LIMIT=300
# Set to "off" to stop writing finding feedback to data/feedback.jsonl
# LABELLENS_FEEDBACK=on
