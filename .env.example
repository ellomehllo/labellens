# Your AI provider key. Server-side only, never sent to the browser.
# The provider is detected from the key: Anthropic (sk-ant-...), OpenAI (sk-...),
# Google Gemini (AIza...) or OpenRouter (sk-or-...).
AI_API_KEY=

# Optional
# AI_PROVIDER=anthropic          # anthropic | openai | gemini | openrouter (only if the key isn't recognised)
# AI_MODEL=                      # defaults: claude-opus-5-5, gpt-6-astra, gemini-3.8-flash, anthropic/claude-opus-5.5
# AI_BASE_URL=                   # for other OpenAI-compatible endpoints (use with AI_PROVIDER=openai)
# PORT=8787
# LABELLENS_DAILY_LIMIT=300      # max AI calls per day across all users (cost control)
# LABELLENS_FEEDBACK=on          # "off" stops writing finding feedback to data/feedback.jsonl
